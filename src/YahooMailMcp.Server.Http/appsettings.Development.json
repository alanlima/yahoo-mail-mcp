{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "YahooMailMcp.Mcp.McpToolTelemetry": "Debug",
      "YahooMailMcp.Server.Http.SanitizedMcpDiagnosticsMiddleware": "Debug"
    }
  },
  "McpDiagnostics": {
    "EnableSanitizedPayloadLogging": true,
    "MaximumInspectedRequestBytes": 65536
  },
  "Mcp": {
    "OAuth": {
      "Enabled": false,
      "TenantId": "",
      "ClientId": "",
      "Audience": "",
      "Resource": "https://mcp.example.com/mcp",
      "RequiredScope": "access_as_user"
    }
  }
}
